{
  "name": "omega-genesis",
  "version": "42.0.0",
  "era": "64 (The Stratum)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "export": "deno run -A tools/export_omega.ts",
    "build:wasm": "cd omega_core && wasm-pack build --target web --out-dir pkg",
    "build": "npm run build:wasm && vite build",
    "serve": "vite preview",
    "generate:phase-goldens": "deno run -A tools/generate_golden.ts",
    "verify:phase-coherence:kernel": "cargo test --manifest-path omega_core/Cargo.toml phase_lattice",
    "verify:phase-coherence:wasm": "deno run -A tools/verify_phase_coherence_wasm.ts",
    "verify:phase-coherence": "deno task verify:phase-coherence:kernel && deno task verify:phase-coherence:wasm",
    "verify:phase-stack": "deno task verify:phase-coherence",
    "verify:golden": "deno run -A tools/verify_golden.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.38",
    "puppeteer": "^24.40.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@helia/strings": "^5.0.7",
    "@libp2p/kad-dht": "^16.1.6",
    "@libp2p/websockets": "^10.1.6",
    "@libp2p/webtransport": "^6.0.15",
    "@libp2p/yamux": "^8.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@multiformats/multiaddr": "^13.0.1",
    "helia": "^6.0.22",
    "libp2p": "^3.1.6",
    "playwright": "^1.58.2"
  }
}
